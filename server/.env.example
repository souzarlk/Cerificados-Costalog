NODE_ENV=production
PORT=8080
HOST=127.0.0.1
# Defina true somente atrás de um proxy reverso confiável na mesma máquina.
TRUST_PROXY=true

# Conexão MariaDB SOMENTE no servidor da empresa. Nunca publicar no portal.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=costalog_agent
DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
DB_NAME=costalog_agent
DB_POOL_MAX=10
DB_SSL=false

# Gere com: npm run keys:generate. Mantenha a chave privada fora do Git.
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
JWT_EXPIRES_IN=15m
POLICY_SIGNING_PRIVATE_KEY_B64=
POLICY_SIGNING_KEY_ID=costalog-policy-2026-01
POLICY_VALIDITY_HOURS=24

# Origens exatas que podem acessar a API via navegador.
ALLOWED_ORIGINS=https://souzarlk.github.io,http://localhost:5173

# Webhook HTTPS opcional para alertas à TI.
SECURITY_ALERT_WEBHOOK_URL=

# Conta inicial criada por: npm run admin:create. Remova estas variáveis após bootstrap.
BOOTSTRAP_ADMIN_EMAIL=admin@empresa.invalid
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_NOW
